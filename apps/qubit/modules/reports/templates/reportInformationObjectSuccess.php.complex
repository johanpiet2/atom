<?php slot('javascripts'); ?>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    console.log('[InfoReport] JS loaded');

    var STORAGE_KEY = 'atom_informationobject_report_columns_v1';

    function loadColumnState() {
      try {
        var raw = window.localStorage.getItem(STORAGE_KEY);
        if (!raw) {
          console.log('[InfoReport] No saved column state, using defaults');
          return {};
        }
        var parsed = JSON.parse(raw);
        console.log('[InfoReport] Loaded column state:', parsed);
        return (parsed && typeof parsed === 'object') ? parsed : {};
      } catch (e) {
        console.warn('[InfoReport] Failed to load column state', e);
        return {};
      }
    }

    function saveColumnState(state) {
      try {
        window.localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        console.log('[InfoReport] Saved column state:', state);
      } catch (e) {
        console.warn('[InfoReport] Failed to save column state', e);
      }
    }

    function setColumnVisibility(key, visible) {
      var selector =
        '.info-report-table table thead th[data-col-key="' + key + '"], ' +
        '.info-report-table table tbody td[data-col-key="' + key + '"]';

      var nodes = document.querySelectorAll(selector);
      nodes.forEach(function (el) {
        if (visible) {
          el.style.display = '';
          el.classList.remove('d-none');
        } else {
          el.style.display = 'none';
          el.classList.add('d-none');
        }
      });
    }

    var state = loadColumnState();

    // Build defaults from currently rendered checkboxes
    var defaultVisible = {};
    document.querySelectorAll('.info-report-col-toggle').forEach(function (cb) {
      var key = cb.getAttribute('data-col-key');
      if (key) {
        defaultVisible[key] = true;
      }
    });

    // Merge defaults into stored state
    Object.keys(defaultVisible).forEach(function (key) {
      if (typeof state[key] === 'undefined') {
        state[key] = defaultVisible[key];
      }
    });

    var checkboxes = document.querySelectorAll('.info-report-col-toggle');

    checkboxes.forEach(function (cb) {
      var key = cb.getAttribute('data-col-key');
      if (!key) {
        return;
      }

      cb.checked = !!state[key];
      setColumnVisibility(key, cb.checked);

      cb.addEventListener('change', function () {
        var visible = cb.checked;
        state[key] = visible;
        console.log('[InfoReport] Column toggled:', key, '=>', visible);
        setColumnVisibility(key, visible);
        saveColumnState(state);
      });
    });

    // Safety: if somehow all columns are hidden, restore defaults
    if (!Object.values(state).some(function (v) { return !!v; })) {
      console.warn('[InfoReport] All columns hidden, restoring defaults');
      Object.keys(defaultVisible).forEach(function (key) {
        state[key] = defaultVisible[key];

        var cb = document.querySelector(
          '.info-report-col-toggle[data-col-key="' + key + '"]'
        );
        if (cb) {
          cb.checked = state[key];
        }

        setColumnVisibility(key, state[key]);
      });
      saveColumnState(state);
    }

    // --- Export table to CSV (only visible columns) ---
    function exportInfoReportCsv() {
      var table = document.querySelector('.info-report-table table');
      if (!table) {
        console.warn('[InfoReport] Table not found for CSV export');
        return;
      }

      console.log('[InfoReport] Starting CSV export');

      var rows = Array.from(table.querySelectorAll('tr'));
      var csv = [];

      rows.forEach(function (row) {
        var cells = Array.from(row.querySelectorAll('th, td'));

        var rowData = cells
          .filter(function (cell) {
            var styleDisplay = window.getComputedStyle(cell).display;
            var keep = styleDisplay !== 'none' && !cell.classList.contains('d-none');
            return keep;
          })
          .map(function (cell) {
            var text = cell.innerText || cell.textContent || '';
            text = text.replace(/\s+/g, ' ').trim();
            if (text.indexOf('"') !== -1 || text.indexOf(',') !== -1 || text.indexOf('\n') !== -1) {
              text = '"' + text.replace(/"/g, '""') + '"';
            }
            return text;
          });

        csv.push(rowData.join(','));
      });

      var csvContent = csv.join('\n');
      console.log('[InfoReport] CSV created, length:', csvContent.length);

      var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      var url = URL.createObjectURL(blob);

      var link = document.createElement('a');
      link.href = url;
      link.download = 'archival_description_report.csv';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      URL.revokeObjectURL(url);

      console.log('[InfoReport] CSV download triggered');
    }

    var exportBtn = document.getElementById('info-report-export-btn');
    if (exportBtn) {
      console.log('[InfoReport] Export button found');
      exportBtn.addEventListener('click', function (e) {
        e.preventDefault();
        console.log('[InfoReport] Export button clicked');
        exportInfoReportCsv();
      });
    } else {
      console.warn('[InfoReport] Export button NOT found');
    }

    // --- Fullscreen toggle ---
    var fullscreenBtn = document.getElementById('info-report-fullscreen-btn');
    if (fullscreenBtn) {
      console.log('[InfoReport] Fullscreen button found');
      fullscreenBtn.addEventListener('click', function (e) {
        e.preventDefault();
        console.log('[InfoReport] Fullscreen button clicked');
        document.body.classList.toggle('info-report-fullscreen');
        console.log('[InfoReport] Body class now:', document.body.className);
      });
    } else {
      console.warn('[InfoReport] Fullscreen button NOT found');
    }
  });
</script>
<?php end_slot(); ?>